# zsh aliases
alias zshconfig="vim ~/.zshrc"

# Git aliases
alias ga='git add'
alias gs='git status'
alias gc='git commit'
alias gpu='git pull'
alias gpuo='git pull origin'
alias gp='git push'
alias gpo='git push origin'
alias gcu='git checkout'
alias gcb='git checkout -b'
alias gd='git diff'

# Current weather
alias wttr='curl -s http://wttr.in/Budapest | head -7 | tail -5'

# GOTO Sites folder
alias sites='cd ~/Sites/'

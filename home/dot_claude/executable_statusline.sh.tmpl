#!/usr/bin/env bash
# Claude Code státuszsor — {{ .theme.name }} (generálva: themes/*.toml)
#   modell · mappa · git branch (+ módosítások) · sorok · költség
# Bemenet: a Claude Code JSON-t küld a stdin-en (model, workspace, cost …).
{{- $t := .theme }}

input="$(cat)"
j() { jq -r "$1 // empty" <<<"$input" 2>/dev/null; }

# hex → truecolor escape
c() { local h="${1#\#}"; printf '\033[38;2;%d;%d;%dm' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }
ACCENT="$(c '{{ $t.accent }}')"
CYAN="$(c '{{ $t.ansi.cyan }}')"
GREEN="$(c '{{ $t.syntax.string }}')"
YELLOW="$(c '{{ $t.ansi.yellow }}')"
RED="$(c '{{ $t.ansi.red }}')"
ORANGE="$(c '{{ $t.extra.orange }}')"
MUTED="$(c '{{ $t.muted }}')"
RESET=$'\033[0m'
SEP="${MUTED} · ${RESET}"

model="$(j '.model.display_name')"
dir="$(j '.workspace.current_dir')"; dir="${dir:-$(j '.cwd')}"; dir="${dir:-$PWD}"
cost="$(j '.cost.total_cost_usd')"
added="$(j '.cost.total_lines_added')"
removed="$(j '.cost.total_lines_removed')"

out="${ACCENT}${model:-Claude}${RESET}"

# mappa: a repó gyökerétől, vagy ~ rövidítéssel
short="${dir/#$HOME/~}"
if root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"; then
  rel="${dir#"$root"}"
  short="$(basename "$root")${rel}"
fi
out+="${SEP}${CYAN}${short}${RESET}"

# git branch + piszkos jelzés
if branch="$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null || git -C "$dir" rev-parse --short HEAD 2>/dev/null)"; then
  if [[ -n "$(git -C "$dir" status --porcelain --untracked-files=no 2>/dev/null | head -1)" ]]; then
    out+="${SEP}${YELLOW} ${branch}*${RESET}"
  else
    out+="${SEP}${GREEN} ${branch}${RESET}"
  fi
fi

if [[ -n "$added$removed" && "$added$removed" != "00" ]]; then
  out+="${SEP}${GREEN}+${added:-0}${RESET} ${RED}-${removed:-0}${RESET}"
fi
if [[ -n "$cost" ]]; then
  out+="${SEP}${ORANGE}\$$(printf '%.2f' "$cost")${RESET}"
fi

printf '%s' "$out"

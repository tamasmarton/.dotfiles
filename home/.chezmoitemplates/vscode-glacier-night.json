  "tokenColors": [
    { "name": "Comment", "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": { "foreground": "{{ $s.comment }}", "fontStyle": "italic" } },
    { "name": "Doc comment tag", "scope": ["comment.block.documentation entity.name.tag", "storage.type.class.jsdoc", "keyword.other.documentation", "storage.type.class.javadoc"], "settings": { "foreground": "{{ $s.decorator }}", "fontStyle": "italic" } },
    { "name": "Doc comment type", "scope": ["comment.block.documentation entity.name.type", "comment.block.javadoc entity.name.type"], "settings": { "foreground": "{{ $s.type }}", "fontStyle": "italic" } },

    { "name": "Variable", "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable.name"], "settings": { "foreground": "{{ $s.variable }}" } },
    { "name": "Parameter", "scope": ["variable.parameter", "meta.parameter variable", "entity.name.variable.parameter"], "settings": { "foreground": "{{ $s.parameter }}", "fontStyle": "italic" } },
    { "name": "Property", "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name", "entity.name.tag.yaml", "variable.other.member", "entity.other.attribute-name.class.css"], "settings": { "foreground": "{{ $s.property }}" } },
    { "name": "Builtin variable", "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super", "support.variable.self"], "settings": { "foreground": "{{ $s.builtin }}", "fontStyle": "italic" } },
    { "name": "Constant", "scope": ["variable.other.constant", "variable.other.enummember", "entity.name.constant", "support.constant", "variable.other.constant.property"], "settings": { "foreground": "{{ $s.constant }}" } },

    { "name": "Keyword", "scope": ["keyword", "keyword.control", "keyword.control.flow", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.other.package", "keyword.other.import", "keyword.function", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"], "settings": { "foreground": "{{ $s.keyword }}" } },
    { "name": "Storage", "scope": ["storage", "storage.type", "storage.modifier", "keyword.other.var", "keyword.declaration", "storage.type.function.arrow"], "settings": { "foreground": "{{ $s.storage }}" } },
    { "name": "Operator", "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value", "punctuation.separator", "punctuation.terminator", "punctuation.definition.parameters", "punctuation.definition.block", "meta.brace", "punctuation.section"], "settings": { "foreground": "{{ $s.operator }}" } },

    { "name": "Function", "scope": ["entity.name.function", "meta.function-call entity.name.function", "support.function", "meta.function.method", "entity.name.method", "variable.function", "meta.method-call entity.name.function"], "settings": { "foreground": "{{ $s.func }}" } },
    { "name": "Builtin function", "scope": ["support.function.builtin", "support.function.go", "support.function.console"], "settings": { "foreground": "{{ $s.func }}", "fontStyle": "italic" } },

    { "name": "Type", "scope": ["entity.name.type", "entity.name.class", "entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "entity.other.inherited-class", "support.type", "support.class", "storage.type.java", "storage.type.go", "storage.type.primitive", "storage.type.numeric.go", "storage.type.string.go", "storage.type.boolean.go", "entity.name.type.module"], "settings": { "foreground": "{{ $s.type }}" } },
    { "name": "Type parameter", "scope": ["entity.name.type.parameter", "storage.type.generic.java", "meta.type.parameters entity.name.type"], "settings": { "foreground": "{{ $s.type }}", "fontStyle": "italic" } },
    { "name": "Namespace / package", "scope": ["entity.name.namespace", "entity.name.type.namespace", "entity.name.package", "storage.modifier.package", "storage.modifier.import", "entity.name.import.go", "support.module"], "settings": { "foreground": "{{ $s.namespace }}" } },
    { "name": "Decorator / annotation", "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "punctuation.definition.annotation", "meta.annotation", "entity.name.type.annotation"], "settings": { "foreground": "{{ $s.decorator }}" } },

    { "name": "String", "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "{{ $s.string }}" } },
    { "name": "Template expression", "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "{{ $s.keyword }}" } },
    { "name": "Escape", "scope": ["constant.character.escape", "constant.other.placeholder", "constant.character.format.placeholder"], "settings": { "foreground": "{{ $s.escape }}" } },
    { "name": "Regex", "scope": ["string.regexp", "constant.other.character-class.regexp"], "settings": { "foreground": "{{ $s.regex }}" } },
    { "name": "Number / boolean / null", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "constant.language.null", "constant.language.undefined", "constant.language.nil", "keyword.other.unit"], "settings": { "foreground": "{{ $s.number }}" } },

    { "name": "Tag", "scope": ["entity.name.tag", "support.class.component", "punctuation.definition.tag"], "settings": { "foreground": "{{ $s.tag }}" } },
    { "name": "Tag punctuation", "scope": ["punctuation.definition.tag.begin", "punctuation.definition.tag.end"], "settings": { "foreground": "{{ $s.operator }}" } },
    { "name": "Attribute", "scope": ["entity.other.attribute-name", "entity.other.attribute-name.jsx", "entity.other.attribute-name.html"], "settings": { "foreground": "{{ $s.attribute }}", "fontStyle": "italic" } },
    { "name": "CSS selector", "scope": ["entity.other.attribute-name.class", "entity.other.attribute-name.id", "entity.name.tag.css", "entity.other.attribute-name.pseudo-class"], "settings": { "foreground": "{{ $s.type }}" } },
    { "name": "CSS property value", "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color"], "settings": { "foreground": "{{ $s.constant }}" } },

    { "name": "JSON key", "scope": ["support.type.property-name.json", "support.type.property-name.json punctuation"], "settings": { "foreground": "{{ $s.property }}" } },
    { "name": "TOML / INI key", "scope": ["support.type.property-name.toml", "keyword.other.definition.ini", "entity.name.section"], "settings": { "foreground": "{{ $s.property }}" } },
    { "name": "Shell variable", "scope": ["variable.other.normal.shell", "variable.other.special.shell", "punctuation.definition.variable.shell"], "settings": { "foreground": "{{ $s.property }}" } },

    { "name": "Markdown heading", "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading.markdown"], "settings": { "foreground": "{{ $t.accent }}", "fontStyle": "bold" } },
    { "name": "Markdown bold", "scope": ["markup.bold"], "settings": { "foreground": "{{ $t.fg_bright }}", "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"], "settings": { "foreground": "{{ $s.string }}" } },
    { "name": "Markdown link", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{ $t.ansi.cyan }}" } },
    { "name": "Markdown quote", "scope": ["markup.quote"], "settings": { "foreground": "{{ $s.comment }}", "fontStyle": "italic" } },
    { "name": "Markdown list", "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"], "settings": { "foreground": "{{ $s.keyword }}" } },

    { "name": "Diff inserted", "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "{{ $s.string }}" } },
    { "name": "Diff deleted", "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "{{ $t.ansi.red }}" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "{{ $t.ansi.yellow }}" } },
    { "name": "Diff range", "scope": ["meta.diff.range", "meta.diff.header"], "settings": { "foreground": "{{ $t.ansi.cyan }}" } },

    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "{{ $t.ansi.red }}" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "{{ $t.muted }}", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "namespace": "{{ $s.namespace }}",
    "type": "{{ $s.type }}",
    "class": "{{ $s.type }}",
    "interface": "{{ $s.type }}",
    "enum": "{{ $s.type }}",
    "struct": "{{ $s.type }}",
    "typeParameter": { "foreground": "{{ $s.type }}", "italic": true },
    "parameter": { "foreground": "{{ $s.parameter }}", "italic": true },
    "variable": "{{ $s.variable }}",
    "variable.readonly": "{{ $s.variable }}",
    "variable.readonly.defaultLibrary": "{{ $s.constant }}",
    "variable.defaultLibrary": { "foreground": "{{ $s.builtin }}", "italic": true },
    "property": "{{ $s.property }}",
    "property.readonly": "{{ $s.property }}",
    "enumMember": "{{ $s.constant }}",
    "function": "{{ $s.func }}",
    "method": "{{ $s.func }}",
    "function.defaultLibrary": { "foreground": "{{ $s.func }}", "italic": true },
    "macro": "{{ $s.decorator }}",
    "decorator": "{{ $s.decorator }}",
    "annotation": "{{ $s.decorator }}",
    "keyword": "{{ $s.keyword }}",
    "modifier": "{{ $s.storage }}",
    "string": "{{ $s.string }}",
    "number": "{{ $s.number }}",
    "regexp": "{{ $s.regex }}",
    "operator": "{{ $s.operator }}",
    "comment": { "foreground": "{{ $s.comment }}", "italic": true },
    "*.deprecated": { "strikethrough": true }
  }
}

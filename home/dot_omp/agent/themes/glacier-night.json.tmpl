{{- $t := .theme -}}
{{- $s := .theme.syntax -}}
{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/tui/src/theme/theme-schema.json",
  "name": "glacier-night",
  "vars": {
    "bg": "{{ $t.bg }}",
    "bgAlt": "{{ $t.bg_alt }}",
    "bgHighlight": "{{ $t.bg_highlight }}",
    "selection": "{{ $t.selection }}",
    "fg": "{{ $t.fg }}",
    "fgBright": "{{ $t.fg_bright }}",
    "muted": "{{ $t.muted }}",
    "dim": "#3B5068",
    "border": "{{ $t.border }}",
    "accent": "{{ $t.accent }}",
    "cursor": "{{ $t.cursor }}",
    "cyan": "{{ $t.ansi.cyan }}",
    "blue": "{{ $s.func }}",
    "green": "{{ $s.string }}",
    "neonGreen": "{{ $t.ansi.green }}",
    "yellow": "{{ $t.ansi.yellow }}",
    "red": "{{ $t.ansi.red }}",
    "pink": "{{ $t.extra.pink }}",
    "magenta": "{{ $s.decorator }}",
    "orange": "{{ $t.extra.orange }}"
  },
  "colors": {
    "accent": "accent",
    "border": "bgHighlight",
    "borderAccent": "accent",
    "borderMuted": "#0E1E2B",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "muted",
    "dim": "dim",
    "text": "fg",
    "thinkingText": "muted",
    "assistantMessageText": "fg",

    "selectedBg": "bgHighlight",
    "userMessageBg": "bgAlt",
    "userMessageText": "fgBright",
    "customMessageBg": "bgAlt",
    "customMessageText": "fg",
    "customMessageLabel": "cyan",
    "toolPendingBg": "bgAlt",
    "toolSuccessBg": "#06191A",
    "toolErrorBg": "#1F0B10",
    "toolTitle": "accent",
    "toolOutput": "fg",
    "statusLineBg": "bgAlt",

    "mdHeading": "accent",
    "mdLink": "cyan",
    "mdLinkUrl": "muted",
    "mdCode": "green",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "bgHighlight",
    "mdQuote": "muted",
    "mdQuoteBorder": "accent",
    "mdHr": "bgHighlight",
    "mdListBullet": "accent",

    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "muted",
    "syntaxComment": "{{ $s.comment }}",
    "syntaxKeyword": "{{ $s.keyword }}",
    "syntaxFunction": "{{ $s.func }}",
    "syntaxVariable": "{{ $s.variable }}",
    "syntaxString": "{{ $s.string }}",
    "syntaxNumber": "{{ $s.number }}",
    "syntaxType": "{{ $s.type }}",
    "syntaxOperator": "{{ $s.operator }}",
    "syntaxPunctuation": "{{ $s.operator }}",

    "thinkingOff": "bgHighlight",
    "thinkingMinimal": "dim",
    "thinkingLow": "border",
    "thinkingMedium": "cyan",
    "thinkingHigh": "accent",
    "thinkingXhigh": "magenta",
    "thinkingMax": "pink",
    "bashMode": "orange",
    "pythonMode": "yellow",

    "statusLineSep": "dim",
    "statusLineModel": "accent",
    "statusLinePath": "cyan",
    "statusLineGitClean": "green",
    "statusLineGitDirty": "yellow",
    "statusLineContext": "muted",
    "statusLineSpend": "orange",
    "statusLineStaged": "green",
    "statusLineDirty": "yellow",
    "statusLineUntracked": "muted",
    "statusLineOutput": "fg",
    "statusLineCost": "orange",
    "statusLineSubagents": "magenta"
  },
  "terminal": {
    "background": "{{ $t.bg }}",
    "foreground": "{{ $t.fg }}",
    "ansi": [
      "{{ $t.ansi.black }}", "{{ $t.ansi.red }}", "{{ $t.ansi.green }}", "{{ $t.ansi.yellow }}",
      "{{ $t.ansi.blue }}", "{{ $t.ansi.magenta }}", "{{ $t.ansi.cyan }}", "{{ $t.ansi.white }}",
      "{{ $t.bright.black }}", "{{ $t.bright.red }}", "{{ $t.bright.green }}", "{{ $t.bright.yellow }}",
      "{{ $t.bright.blue }}", "{{ $t.bright.magenta }}", "{{ $t.bright.cyan }}", "{{ $t.bright.white }}"
    ]
  },
  "symbols": {
    "preset": "nerd"
  }
}

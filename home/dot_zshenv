# ~/.zshenv — minden zsh indításkor lefut (scriptekben is), ezért itt csak környezeti változók.
# A tényleges config a ~/.config/zsh alatt van (ZDOTDIR).

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export LESS="-R --mouse"

# Minimál Linuxon (SSH) gyakran nincs locale: UTF-8 kell az ikonokhoz és a tmuxhoz
export LANG="${LANG:-C.UTF-8}"

export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_BUNDLE_FILE_GLOBAL="$XDG_CONFIG_HOME/homebrew/Brewfile"

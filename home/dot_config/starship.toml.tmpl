# Starship prompt — {{ .theme.name }}
# Generálva: home/dot_config/starship.toml.tmpl + themes/*.toml
# Az ikonok Nerd Font v3 glyphek (JetBrainsMono Nerd Font nélkül üresnek látszanak).
{{- $t := .theme }}

"$schema" = "https://starship.rs/config-schema.json"

add_newline = true
command_timeout = 1000
palette = "{{ .theme.name | replace "-" "_" }}"

format = """
$os\
$username\
$hostname\
$container\
$directory\
$git_branch\
$git_state\
$git_status\
$fill\
$cmd_duration\
$nodejs\
$golang\
$java\
$rust\
$python\
$docker_context\
$time
$character"""

[palettes.{{ .theme.name | replace "-" "_" }}]
fg = "{{ $t.fg }}"
fg_bright = "{{ $t.fg_bright }}"
muted = "{{ $t.muted }}"
accent = "{{ $t.accent }}"
cursor = "{{ $t.cursor }}"
cyan = "{{ $t.ansi.cyan }}"
blue = "{{ $t.ansi.blue }}"
green = "{{ $t.ansi.green }}"
yellow = "{{ $t.ansi.yellow }}"
red = "{{ $t.ansi.red }}"
magenta = "{{ $t.ansi.magenta }}"
pink = "{{ $t.extra.pink }}"
orange = "{{ $t.extra.orange }}"

# ── Bal oldal ───────────────────────────────────────────────────────────
[os]
disabled = false
style = "fg_bright"
format = "[$symbol]($style)"

[os.symbols]
Macos = " "
Ubuntu = " "
Debian = " "
Alpine = " "
Fedora = " "
Linux = " "

[username]
show_always = false            # csak SSH-n / rootként
style_user = "yellow"
style_root = "red bold"
format = "[$user]($style)[@](muted)"

[hostname]
ssh_only = true
style = "yellow"
format = "[$hostname]($style) "

[container]
symbol = " "
style = "blue"
format = "[$symbol$name]($style) "

[directory]
style = "cyan bold"
read_only = " "
read_only_style = "red"
truncation_length = 3
truncate_to_repo = true
truncation_symbol = "…/"
repo_root_style = "accent bold"
format = "[$path]($style)[$read_only]($read_only_style) "

[git_branch]
symbol = " "
style = "green"
truncation_length = 32
format = "[on](muted) [$symbol$branch(:$remote_branch)]($style) "

[git_state]
style = "orange bold"
format = "[\\($state( $progress_current/$progress_total)\\)]($style) "

[git_status]
style = "yellow"
format = "([$all_status$ahead_behind]($style) )"
conflicted = "[=$count](red) "
ahead = "[⇡$count](accent) "
behind = "[⇣$count](pink) "
diverged = "[⇕⇡$ahead_count⇣$behind_count](pink) "
untracked = "[?$count](muted) "
stashed = "[\\$$count](cyan) "
modified = "[!$count](yellow) "
staged = "[+$count](green) "
renamed = "[»$count](cyan) "
deleted = "[✘$count](red) "

[fill]
symbol = " "

# ── Jobb oldal ──────────────────────────────────────────────────────────
[cmd_duration]
min_time = 2000
style = "yellow"
format = "[ $duration]($style) "

[nodejs]
symbol = " "
style = "green"
format = "[$symbol($version)]($style) "

[golang]
symbol = " "
style = "cyan"
format = "[$symbol($version)]($style) "

[java]
symbol = " "
style = "orange"
format = "[$symbol($version)]($style) "

[rust]
symbol = " "
style = "orange"
format = "[$symbol($version)]($style) "

[python]
symbol = " "
style = "yellow"
format = "[$symbol($version)( \\($virtualenv\\))]($style) "

[docker_context]
symbol = " "
style = "blue"
only_with_files = true
format = "[$symbol$context]($style) "

[time]
disabled = false
time_format = "%H:%M"
style = "muted"
format = "[$time]($style)"

# ── Második sor ─────────────────────────────────────────────────────────
[character]
success_symbol = "[❯](cursor)"
error_symbol = "[❯](red)"
vimcmd_symbol = "[❮](accent)"

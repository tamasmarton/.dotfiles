# Homebrew csomagok — a chezmoi generálja: home/dot_config/homebrew/Brewfile.tmpl
# Profil: {{ .profile }}
#
# Kezelés:  brewfile install | upgrade | check | cleanup | edit
# Változás után a `chezmoi apply` automatikusan lefuttatja a `brewfile install`-t.
#
# Runtime-ok (node, go, java, rust) NEM innen jönnek, hanem a mise-ből.

# ── Tapek ───────────────────────────────────────────────────────────────
tap "can1357/tap"               # oh-my-pi (omp)
tap "nikitabobko/tap"           # AeroSpace

# ── Alap ────────────────────────────────────────────────────────────────
brew "git"
brew "gh"
brew "chezmoi"
brew "mise"                     # node / go / java / rust verziókezelő (nvm helyett)
brew "wget"
brew "coreutils"
brew "gnu-sed"
brew "jq"
brew "yq"

# ── Shell ───────────────────────────────────────────────────────────────
brew "starship"                 # prompt
brew "fzf"
brew "zoxide"                   # okos cd
brew "eza"                      # ls
brew "bat"                      # cat
brew "fd"                       # find
brew "ripgrep"                  # grep
brew "tlrc"                     # tldr
brew "btop"
brew "atuin"                    # kereshető shell history

# ── Terminál workflow ───────────────────────────────────────────────────
brew "tmux"
brew "sesh"                     # tmux session-ök zoxide alapján
brew "yazi"                     # fájlkezelő
brew "lazygit"
brew "lazydocker"
brew "git-delta"                # diff pager

# ── AI agent TUI-k ──────────────────────────────────────────────────────
brew "herdr"                    # agent multiplexer (több Claude / omp session egy helyen)
brew "can1357/tap/omp"          # oh-my-pi coding agent

# ── Neovim ──────────────────────────────────────────────────────────────
brew "neovim"
brew "tree-sitter-cli"

# ── Terminál és font ────────────────────────────────────────────────────
cask "wezterm@nightly"
cask "font-jetbrains-mono-nerd-font"
cask "ghostty"                  # alternatív terminál (a config a WezTerm palettáját használja)

# ── Közös appok ─────────────────────────────────────────────────────────
cask "visual-studio-code"
vscode "pkief.material-icon-theme"   # fájlikonok (a Glacier Night témát a chezmoi telepíti)
cask "docker-desktop"
cask "claude-code"
cask "1password-cli"            # titkok a chezmoi sablonokba (op read)
cask "stats"                    # menüsoros rendszerfigyelő
cask "raycast"                  # Spotlight helyett: launcher, ablakkezelés, vágólap
cask "nikitabobko/tap/aerospace" # tiling ablakkezelő (opcionális, alapból nem indul el)
{{- if .isPersonal }}

# ── Személyes ───────────────────────────────────────────────────────────
cask "brave-browser"
cask "spotify"
cask "vlc"
cask "itsycal"
cask "hiddenbar"
{{- end }}
{{- if .isWork }}

# ── Céges ───────────────────────────────────────────────────────────────
# Ide jönnek a céges gép extra csomagjai.
{{- end }}

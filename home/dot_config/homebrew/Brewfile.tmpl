# Homebrew csomagok — a chezmoi generálja: home/dot_config/homebrew/Brewfile.tmpl
# Profil: {{ .profile }}{{ if not .gui }} (szerver: csak terminálos formulák, nincs cask / VS Code){{ end }}
#
# Kezelés:  brewfile install | upgrade | check | cleanup | edit
# Változás után a `chezmoi apply` automatikusan lefuttatja a `brewfile install`-t.
#
# Runtime-ok (node, go, java, rust) NEM innen jönnek, hanem a mise-ből.
#
# Szerkezet: ez a fájl a terminálos formulákat tartalmazza (minden gépen ugyanaz); a GUI-s rész
# (casks, taps, VS Code bővítmények) profilonként külön fájlban van: brewfile-personal.rb, brewfile-work.rb.

# ── Tapek ───────────────────────────────────────────────────────────────
tap "can1357/tap"               # oh-my-pi (omp)

# ── Alap ────────────────────────────────────────────────────────────────
brew "git"
brew "gh"
brew "chezmoi"
brew "mise"                     # node / go / java / rust verziókezelő (nvm helyett)
brew "wget"
brew "coreutils"
brew "gnu-sed"
brew "jq"
brew "yq"

# ── Shell ───────────────────────────────────────────────────────────────
brew "starship"                 # prompt
brew "fzf"
brew "zoxide"                   # okos cd
brew "eza"                      # ls
brew "bat"                      # cat
brew "fd"                       # find
brew "ripgrep"                  # grep
brew "tlrc"                     # tldr
brew "btop"
brew "atuin"                    # kereshető shell history

# ── Terminál workflow ───────────────────────────────────────────────────
brew "tmux"
brew "sesh"                     # tmux session-ök zoxide alapján
brew "yazi"                     # fájlkezelő
brew "lazygit"
brew "git-delta"                # diff pager

# ── AI agent TUI-k ──────────────────────────────────────────────────────
brew "herdr"                    # agent multiplexer (több Claude / omp session egy helyen)
brew "can1357/tap/omp"          # oh-my-pi coding agent

# ── Neovim ──────────────────────────────────────────────────────────────
brew "neovim"
brew "tree-sitter-cli"

{{- if .gui }}

# ══ GUI-s rész: profilonként külön, teljesen önálló lista ══════════════════
# Profil: {{ .profile }} → home/.chezmoitemplates/brewfile-{{ .profile }}.rb
# (új GUI-s profilhoz ugyanilyen nevű fájl kell)
{{ includeTemplate (printf "brewfile-%s.rb" .profile) . | trim }}
{{- end }}

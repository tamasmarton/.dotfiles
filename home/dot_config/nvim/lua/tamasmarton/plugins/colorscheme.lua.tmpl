-- Tokyonight Night alapon {{ .theme.name }} (generálva: themes/*.toml)
-- A felület a [theme], a kódszínezés a [theme.syntax] palettából jön — ugyanaz, mint a VS Code {{ .theme.name | title }} témában.
{{- $t := .theme }}
{{- $s := .theme.syntax }}
return {
  "folke/tokyonight.nvim",
  lazy = false,
  priority = 1000,
  config = function()
    local p = {
      bg = "{{ $t.bg }}",
      bg_alt = "{{ $t.bg_alt }}",
      bg_highlight = "{{ $t.bg_highlight }}",
      selection = "{{ $t.selection }}",
      fg = "{{ $t.fg }}",
      fg_bright = "{{ $t.fg_bright }}",
      muted = "{{ $t.muted }}",
      border = "{{ $t.border }}",
      accent = "{{ $t.accent }}",
      cursor = "{{ $t.cursor }}",
      yellow = "{{ $t.ansi.yellow }}",
    }

    require("tokyonight").setup({
      style = "night",
      transparent = true,               -- a WezTerm háttere (és blurja) látszik
      styles = {
        sidebars = "transparent",
        floats = "transparent",
        comments = { italic = true },
      },
      on_colors = function(c)
        c.bg = p.bg
        c.bg_dark = p.bg_alt
        c.bg_float = p.bg_alt
        c.bg_popup = p.bg_alt
        c.bg_sidebar = p.bg_alt
        c.bg_statusline = p.bg_alt
        c.bg_highlight = p.bg_highlight
        c.bg_search = "#0A64AC"
        c.bg_visual = p.selection
        c.border = p.border
        c.border_highlight = p.accent
        c.fg = p.fg
        c.fg_dark = "#B4D0E9"
        c.fg_float = p.fg
        c.fg_sidebar = "#B4D0E9"
        c.fg_gutter = "#3B5068"
        c.comment = p.muted
      end,
      on_highlights = function(hl, c)
        hl.CursorLineNr = { fg = p.accent, bold = true }
        hl.LineNr = { fg = "#3B5068" }
        hl.FloatBorder = { fg = p.border }
        hl.FloatTitle = { fg = p.accent, bold = true }
        hl.WinSeparator = { fg = p.bg_highlight }
        hl.Cursor = { fg = p.bg, bg = p.cursor }
        hl.Search = { fg = p.fg_bright, bg = "#0A64AC" }
        hl.IncSearch = { fg = p.bg, bg = p.yellow }
        hl.SnacksIndentScope = { fg = p.accent }
        hl.SnacksDashboardHeader = { fg = p.accent }
        hl.SnacksDashboardKey = { fg = p.cursor }
        hl.SnacksDashboardIcon = { fg = p.accent }
        hl.SnacksPickerMatch = { fg = p.accent, bold = true }
        hl.NvimTreeFolderIcon = { fg = "{{ $t.ansi.cyan }}" }
        hl.NvimTreeRootFolder = { fg = p.accent, bold = true }

        -- ── Kódszínezés: treesitter + LSP szemantikus tokenek ([theme.syntax]) ──
        local s = {
          comment = "{{ $s.comment }}", keyword = "{{ $s.keyword }}", storage = "{{ $s.storage }}",
          func = "{{ $s.func }}", type = "{{ $s.type }}", string = "{{ $s.string }}",
          number = "{{ $s.number }}", constant = "{{ $s.constant }}", variable = "{{ $s.variable }}",
          parameter = "{{ $s.parameter }}", property = "{{ $s.property }}", operator = "{{ $s.operator }}",
          tag = "{{ $s.tag }}", attribute = "{{ $s.attribute }}", decorator = "{{ $s.decorator }}",
          builtin = "{{ $s.builtin }}", namespace = "{{ $s.namespace }}", regex = "{{ $s.regex }}",
          escape = "{{ $s.escape }}",
        }
        local groups = {
          comment = { "Comment", "@comment" },
          keyword = {
            "Keyword", "Statement", "Conditional", "Repeat", "Include", "Exception",
            "@keyword", "@keyword.function", "@keyword.return", "@keyword.import", "@keyword.export",
            "@keyword.conditional", "@keyword.repeat", "@keyword.exception", "@keyword.coroutine",
            "@keyword.operator", "@keyword.directive",
          },
          storage = { "StorageClass", "@keyword.modifier", "@keyword.type", "@keyword.storage" },
          func = {
            "Function", "@function", "@function.call", "@function.method", "@function.method.call",
            "@constructor", "@lsp.type.function", "@lsp.type.method",
          },
          type = {
            "Type", "Structure", "@type", "@type.definition", "@type.builtin",
            "@lsp.type.type", "@lsp.type.class", "@lsp.type.interface", "@lsp.type.enum", "@lsp.type.struct",
          },
          string = { "String", "@string", "@string.special", "@character" },
          number = { "Number", "Boolean", "Float", "@number", "@number.float", "@boolean", "@constant.builtin" },
          constant = { "Constant", "@constant", "@constant.macro", "@lsp.type.enumMember" },
          variable = { "Identifier", "@variable", "@lsp.type.variable" },
          parameter = { "@variable.parameter", "@lsp.type.parameter" },
          property = { "@property", "@variable.member", "@field", "@lsp.type.property" },
          operator = { "Operator", "Delimiter", "@operator", "@punctuation.delimiter", "@punctuation.bracket" },
          tag = { "@tag", "@tag.builtin" },
          attribute = { "@tag.attribute" },
          decorator = { "@attribute", "@attribute.builtin", "@lsp.type.decorator", "@lsp.type.annotation", "PreProc" },
          builtin = { "@variable.builtin", "@function.builtin", "@lsp.typemod.variable.defaultLibrary" },
          namespace = { "@module", "@module.builtin", "@lsp.type.namespace" },
          regex = { "@string.regexp" },
          escape = { "@string.escape", "SpecialChar" },
        }
        local italic = { comment = true, parameter = true, builtin = true, attribute = true }
        for role, names in pairs(groups) do
          for _, name in ipairs(names) do
            hl[name] = { fg = s[role], italic = italic[role] or nil }
          end
        end
        hl["@punctuation.special"] = { fg = s.keyword }   -- ${} template literalban
        hl["@markup.heading"] = { fg = p.accent, bold = true }
        hl["@markup.link.url"] = { fg = "{{ $t.ansi.cyan }}", underline = true }
        hl["@markup.raw"] = { fg = s.string }
      end,
    })
    vim.cmd.colorscheme("tokyonight")
  end,
}

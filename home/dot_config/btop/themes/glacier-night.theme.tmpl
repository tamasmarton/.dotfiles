# btop — glacier-night (generálva: .chezmoidata/theme.toml)
{{- $t := .theme }}
theme[main_bg]=""
theme[main_fg]="{{ $t.fg }}"
theme[title]="{{ $t.fg_bright }}"
theme[hi_fg]="{{ $t.accent }}"
theme[selected_bg]="{{ $t.bg_highlight }}"
theme[selected_fg]="{{ $t.fg_bright }}"
theme[inactive_fg]="{{ $t.muted }}"
theme[graph_text]="{{ $t.muted }}"
theme[meter_bg]="{{ $t.bg_highlight }}"
theme[proc_misc]="{{ $t.ansi.cyan }}"
theme[cpu_box]="{{ $t.border }}"
theme[mem_box]="{{ $t.border }}"
theme[net_box]="{{ $t.border }}"
theme[proc_box]="{{ $t.border }}"
theme[div_line]="{{ $t.bg_highlight }}"
theme[temp_start]="{{ $t.ansi.green }}"
theme[temp_mid]="{{ $t.ansi.yellow }}"
theme[temp_end]="{{ $t.ansi.red }}"
theme[cpu_start]="{{ $t.accent }}"
theme[cpu_mid]="{{ $t.ansi.cyan }}"
theme[cpu_end]="{{ $t.extra.pink }}"
theme[free_start]="{{ $t.ansi.green }}"
theme[free_mid]="{{ $t.ansi.green }}"
theme[free_end]="{{ $t.bright.green }}"
theme[cached_start]="{{ $t.ansi.cyan }}"
theme[cached_mid]="{{ $t.ansi.cyan }}"
theme[cached_end]="{{ $t.accent }}"
theme[available_start]="{{ $t.ansi.yellow }}"
theme[available_mid]="{{ $t.ansi.yellow }}"
theme[available_end]="{{ $t.bright.yellow }}"
theme[used_start]="{{ $t.extra.orange }}"
theme[used_mid]="{{ $t.ansi.red }}"
theme[used_end]="{{ $t.extra.pink }}"
theme[download_start]="{{ $t.ansi.cyan }}"
theme[download_mid]="{{ $t.accent }}"
theme[download_end]="{{ $t.bright.green }}"
theme[upload_start]="{{ $t.ansi.magenta }}"
theme[upload_mid]="{{ $t.extra.pink }}"
theme[upload_end]="{{ $t.ansi.red }}"
theme[process_start]="{{ $t.accent }}"
theme[process_mid]="{{ $t.ansi.cyan }}"
theme[process_end]="{{ $t.extra.pink }}"

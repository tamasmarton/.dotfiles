  "tokenColors": [
    { "name": "Comment", "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": { "foreground": "#66768A", "fontStyle": "italic" } },
    { "name": "Doc comment tag", "scope": ["comment.block.documentation entity.name.tag", "storage.type.class.jsdoc", "keyword.other.documentation", "storage.type.class.javadoc"], "settings": { "foreground": "#C792EA", "fontStyle": "italic" } },
    { "name": "Doc comment type", "scope": ["comment.block.documentation entity.name.type", "comment.block.javadoc entity.name.type"], "settings": { "foreground": "#E0BC72", "fontStyle": "italic" } },

    { "name": "Variable", "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable.name"], "settings": { "foreground": "#B2BCC8" } },
    { "name": "Parameter", "scope": ["variable.parameter", "meta.parameter variable", "entity.name.variable.parameter"], "settings": { "foreground": "#C9B5EA", "fontStyle": "italic" } },
    { "name": "Property", "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name", "entity.name.tag.yaml", "variable.other.member", "entity.other.attribute-name.class.css"], "settings": { "foreground": "#8CC6DE" } },
    { "name": "Builtin variable", "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super", "support.variable.self"], "settings": { "foreground": "#E58BB0", "fontStyle": "italic" } },
    { "name": "Constant", "scope": ["variable.other.constant", "variable.other.enummember", "entity.name.constant", "support.constant", "variable.other.constant.property"], "settings": { "foreground": "#EBB57E" } },

    { "name": "Keyword", "scope": ["keyword", "keyword.control", "keyword.control.flow", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.other.package", "keyword.other.import", "keyword.function", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"], "settings": { "foreground": "#6CB6EB" } },
    { "name": "Storage", "scope": ["storage", "storage.type", "storage.modifier", "keyword.other.var", "keyword.declaration", "storage.type.function.arrow"], "settings": { "foreground": "#8E9BF2" } },
    { "name": "Operator", "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value", "punctuation.separator", "punctuation.terminator", "punctuation.definition.parameters", "punctuation.definition.block", "meta.brace", "punctuation.section"], "settings": { "foreground": "#7F93AB" } },

    { "name": "Function", "scope": ["entity.name.function", "meta.function-call entity.name.function", "support.function", "meta.function.method", "entity.name.method", "variable.function", "meta.method-call entity.name.function"], "settings": { "foreground": "#9AD0F7" } },
    { "name": "Builtin function", "scope": ["support.function.builtin", "support.function.go", "support.function.console"], "settings": { "foreground": "#9AD0F7", "fontStyle": "italic" } },

    { "name": "Type", "scope": ["entity.name.type", "entity.name.class", "entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "entity.other.inherited-class", "support.type", "support.class", "storage.type.java", "storage.type.go", "storage.type.primitive", "storage.type.numeric.go", "storage.type.string.go", "storage.type.boolean.go", "entity.name.type.module"], "settings": { "foreground": "#E0BC72" } },
    { "name": "Type parameter", "scope": ["entity.name.type.parameter", "storage.type.generic.java", "meta.type.parameters entity.name.type"], "settings": { "foreground": "#E0BC72", "fontStyle": "italic" } },
    { "name": "Namespace / package", "scope": ["entity.name.namespace", "entity.name.type.namespace", "entity.name.package", "storage.modifier.package", "storage.modifier.import", "entity.name.import.go", "support.module"], "settings": { "foreground": "#8FA8F0" } },
    { "name": "Decorator / annotation", "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "punctuation.definition.annotation", "meta.annotation", "entity.name.type.annotation"], "settings": { "foreground": "#C792EA" } },

    { "name": "String", "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#96CDAE" } },
    { "name": "Template expression", "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#6CB6EB" } },
    { "name": "Escape", "scope": ["constant.character.escape", "constant.other.placeholder", "constant.character.format.placeholder"], "settings": { "foreground": "#E58BB0" } },
    { "name": "Regex", "scope": ["string.regexp", "constant.other.character-class.regexp"], "settings": { "foreground": "#E8A262" } },
    { "name": "Number / boolean / null", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "constant.language.null", "constant.language.undefined", "constant.language.nil", "keyword.other.unit"], "settings": { "foreground": "#E8A262" } },

    { "name": "Tag", "scope": ["entity.name.tag", "support.class.component", "punctuation.definition.tag"], "settings": { "foreground": "#E58BB0" } },
    { "name": "Tag punctuation", "scope": ["punctuation.definition.tag.begin", "punctuation.definition.tag.end"], "settings": { "foreground": "#7F93AB" } },
    { "name": "Attribute", "scope": ["entity.other.attribute-name", "entity.other.attribute-name.jsx", "entity.other.attribute-name.html"], "settings": { "foreground": "#E5C98F", "fontStyle": "italic" } },
    { "name": "CSS selector", "scope": ["entity.other.attribute-name.class", "entity.other.attribute-name.id", "entity.name.tag.css", "entity.other.attribute-name.pseudo-class"], "settings": { "foreground": "#E0BC72" } },
    { "name": "CSS property value", "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color"], "settings": { "foreground": "#EBB57E" } },

    { "name": "JSON key", "scope": ["support.type.property-name.json", "support.type.property-name.json punctuation"], "settings": { "foreground": "#8CC6DE" } },
    { "name": "TOML / INI key", "scope": ["support.type.property-name.toml", "keyword.other.definition.ini", "entity.name.section"], "settings": { "foreground": "#8CC6DE" } },
    { "name": "Shell variable", "scope": ["variable.other.normal.shell", "variable.other.special.shell", "punctuation.definition.variable.shell"], "settings": { "foreground": "#8CC6DE" } },

    { "name": "Markdown heading", "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading.markdown"], "settings": { "foreground": "#4AA3D1", "fontStyle": "bold" } },
    { "name": "Markdown bold", "scope": ["markup.bold"], "settings": { "foreground": "#DDE5EE", "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"], "settings": { "foreground": "#96CDAE" } },
    { "name": "Markdown link", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#55B6D4" } },
    { "name": "Markdown quote", "scope": ["markup.quote"], "settings": { "foreground": "#66768A", "fontStyle": "italic" } },
    { "name": "Markdown list", "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"], "settings": { "foreground": "#6CB6EB" } },

    { "name": "Diff inserted", "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#96CDAE" } },
    { "name": "Diff deleted", "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#E5707A" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#E0BC72" } },
    { "name": "Diff range", "scope": ["meta.diff.range", "meta.diff.header"], "settings": { "foreground": "#55B6D4" } },

    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E5707A" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "#7D8A99", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "namespace": "#8FA8F0",
    "type": "#E0BC72",
    "class": "#E0BC72",
    "interface": "#E0BC72",
    "enum": "#E0BC72",
    "struct": "#E0BC72",
    "typeParameter": { "foreground": "#E0BC72", "italic": true },
    "parameter": { "foreground": "#C9B5EA", "italic": true },
    "variable": "#B2BCC8",
    "variable.readonly": "#B2BCC8",
    "variable.readonly.defaultLibrary": "#EBB57E",
    "variable.defaultLibrary": { "foreground": "#E58BB0", "italic": true },
    "property": "#8CC6DE",
    "property.readonly": "#8CC6DE",
    "enumMember": "#EBB57E",
    "function": "#9AD0F7",
    "method": "#9AD0F7",
    "function.defaultLibrary": { "foreground": "#9AD0F7", "italic": true },
    "macro": "#C792EA",
    "decorator": "#C792EA",
    "annotation": "#C792EA",
    "keyword": "#6CB6EB",
    "modifier": "#8E9BF2",
    "string": "#96CDAE",
    "number": "#E8A262",
    "regexp": "#E8A262",
    "operator": "#7F93AB",
    "comment": { "foreground": "#66768A", "italic": true },
    "*.deprecated": { "strikethrough": true }
  }
}

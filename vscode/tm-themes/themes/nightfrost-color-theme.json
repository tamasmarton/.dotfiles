  "tokenColors": [
    { "name": "Comment", "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": { "foreground": "#627590", "fontStyle": "italic" } },
    { "name": "Doc comment tag", "scope": ["comment.block.documentation entity.name.tag", "storage.type.class.jsdoc", "keyword.other.documentation", "storage.type.class.javadoc"], "settings": { "foreground": "#D68BE6", "fontStyle": "italic" } },
    { "name": "Doc comment type", "scope": ["comment.block.documentation entity.name.type", "comment.block.javadoc entity.name.type"], "settings": { "foreground": "#E5C46B", "fontStyle": "italic" } },

    { "name": "Variable", "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable.name"], "settings": { "foreground": "#B4C4D4" } },
    { "name": "Parameter", "scope": ["variable.parameter", "meta.parameter variable", "entity.name.variable.parameter"], "settings": { "foreground": "#D0B8EE", "fontStyle": "italic" } },
    { "name": "Property", "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name", "entity.name.tag.yaml", "variable.other.member", "entity.other.attribute-name.class.css"], "settings": { "foreground": "#8DBFD8" } },
    { "name": "Builtin variable", "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super", "support.variable.self"], "settings": { "foreground": "#E57AA6", "fontStyle": "italic" } },
    { "name": "Constant", "scope": ["variable.other.constant", "variable.other.enummember", "entity.name.constant", "support.constant", "variable.other.constant.property"], "settings": { "foreground": "#F0B67A" } },

    { "name": "Keyword", "scope": ["keyword", "keyword.control", "keyword.control.flow", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.other.package", "keyword.other.import", "keyword.function", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"], "settings": { "foreground": "#3CC8DC" } },
    { "name": "Storage", "scope": ["storage", "storage.type", "storage.modifier", "keyword.other.var", "keyword.declaration", "storage.type.function.arrow"], "settings": { "foreground": "#6BA6F0" } },
    { "name": "Operator", "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value", "punctuation.separator", "punctuation.terminator", "punctuation.definition.parameters", "punctuation.definition.block", "meta.brace", "punctuation.section"], "settings": { "foreground": "#7F97B2" } },

    { "name": "Function", "scope": ["entity.name.function", "meta.function-call entity.name.function", "support.function", "meta.function.method", "entity.name.method", "variable.function", "meta.method-call entity.name.function"], "settings": { "foreground": "#8CBFF8" } },
    { "name": "Builtin function", "scope": ["support.function.builtin", "support.function.go", "support.function.console"], "settings": { "foreground": "#8CBFF8", "fontStyle": "italic" } },

    { "name": "Type", "scope": ["entity.name.type", "entity.name.class", "entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "entity.other.inherited-class", "support.type", "support.class", "storage.type.java", "storage.type.go", "storage.type.primitive", "storage.type.numeric.go", "storage.type.string.go", "storage.type.boolean.go", "entity.name.type.module"], "settings": { "foreground": "#E5C46B" } },
    { "name": "Type parameter", "scope": ["entity.name.type.parameter", "storage.type.generic.java", "meta.type.parameters entity.name.type"], "settings": { "foreground": "#E5C46B", "fontStyle": "italic" } },
    { "name": "Namespace / package", "scope": ["entity.name.namespace", "entity.name.type.namespace", "entity.name.package", "storage.modifier.package", "storage.modifier.import", "entity.name.import.go", "support.module"], "settings": { "foreground": "#8AA2E8" } },
    { "name": "Decorator / annotation", "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "punctuation.definition.annotation", "meta.annotation", "entity.name.type.annotation"], "settings": { "foreground": "#D68BE6" } },

    { "name": "String", "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#93D3B4" } },
    { "name": "Template expression", "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#3CC8DC" } },
    { "name": "Escape", "scope": ["constant.character.escape", "constant.other.placeholder", "constant.character.format.placeholder"], "settings": { "foreground": "#E57AA6" } },
    { "name": "Regex", "scope": ["string.regexp", "constant.other.character-class.regexp"], "settings": { "foreground": "#F2A25C" } },
    { "name": "Number / boolean / null", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "constant.language.null", "constant.language.undefined", "constant.language.nil", "keyword.other.unit"], "settings": { "foreground": "#F2A25C" } },

    { "name": "Tag", "scope": ["entity.name.tag", "support.class.component", "punctuation.definition.tag"], "settings": { "foreground": "#E57AA6" } },
    { "name": "Tag punctuation", "scope": ["punctuation.definition.tag.begin", "punctuation.definition.tag.end"], "settings": { "foreground": "#7F97B2" } },
    { "name": "Attribute", "scope": ["entity.other.attribute-name", "entity.other.attribute-name.jsx", "entity.other.attribute-name.html"], "settings": { "foreground": "#EBCB8B", "fontStyle": "italic" } },
    { "name": "CSS selector", "scope": ["entity.other.attribute-name.class", "entity.other.attribute-name.id", "entity.name.tag.css", "entity.other.attribute-name.pseudo-class"], "settings": { "foreground": "#E5C46B" } },
    { "name": "CSS property value", "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color"], "settings": { "foreground": "#F0B67A" } },

    { "name": "JSON key", "scope": ["support.type.property-name.json", "support.type.property-name.json punctuation"], "settings": { "foreground": "#8DBFD8" } },
    { "name": "TOML / INI key", "scope": ["support.type.property-name.toml", "keyword.other.definition.ini", "entity.name.section"], "settings": { "foreground": "#8DBFD8" } },
    { "name": "Shell variable", "scope": ["variable.other.normal.shell", "variable.other.special.shell", "punctuation.definition.variable.shell"], "settings": { "foreground": "#8DBFD8" } },

    { "name": "Markdown heading", "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading.markdown"], "settings": { "foreground": "#3CC8DC", "fontStyle": "bold" } },
    { "name": "Markdown bold", "scope": ["markup.bold"], "settings": { "foreground": "#DCE6F0", "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"], "settings": { "foreground": "#93D3B4" } },
    { "name": "Markdown link", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#4FB8DA" } },
    { "name": "Markdown quote", "scope": ["markup.quote"], "settings": { "foreground": "#627590", "fontStyle": "italic" } },
    { "name": "Markdown list", "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"], "settings": { "foreground": "#3CC8DC" } },

    { "name": "Diff inserted", "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#93D3B4" } },
    { "name": "Diff deleted", "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#F06A6A" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#E5C46B" } },
    { "name": "Diff range", "scope": ["meta.diff.range", "meta.diff.header"], "settings": { "foreground": "#4FB8DA" } },

    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#F06A6A" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "#6F8197", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "namespace": "#8AA2E8",
    "type": "#E5C46B",
    "class": "#E5C46B",
    "interface": "#E5C46B",
    "enum": "#E5C46B",
    "struct": "#E5C46B",
    "typeParameter": { "foreground": "#E5C46B", "italic": true },
    "parameter": { "foreground": "#D0B8EE", "italic": true },
    "variable": "#B4C4D4",
    "variable.readonly": "#B4C4D4",
    "variable.readonly.defaultLibrary": "#F0B67A",
    "variable.defaultLibrary": { "foreground": "#E57AA6", "italic": true },
    "property": "#8DBFD8",
    "property.readonly": "#8DBFD8",
    "enumMember": "#F0B67A",
    "function": "#8CBFF8",
    "method": "#8CBFF8",
    "function.defaultLibrary": { "foreground": "#8CBFF8", "italic": true },
    "macro": "#D68BE6",
    "decorator": "#D68BE6",
    "annotation": "#D68BE6",
    "keyword": "#3CC8DC",
    "modifier": "#6BA6F0",
    "string": "#93D3B4",
    "number": "#F2A25C",
    "regexp": "#F2A25C",
    "operator": "#7F97B2",
    "comment": { "foreground": "#627590", "italic": true },
    "*.deprecated": { "strikethrough": true }
  }
}

  "tokenColors": [
    { "name": "Comment", "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": { "foreground": "#5A6B82", "fontStyle": "italic" } },
    { "name": "Doc comment tag", "scope": ["comment.block.documentation entity.name.tag", "storage.type.class.jsdoc", "keyword.other.documentation", "storage.type.class.javadoc"], "settings": { "foreground": "#E879F9", "fontStyle": "italic" } },
    { "name": "Doc comment type", "scope": ["comment.block.documentation entity.name.type", "comment.block.javadoc entity.name.type"], "settings": { "foreground": "#F6C945", "fontStyle": "italic" } },

    { "name": "Variable", "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable.name"], "settings": { "foreground": "#CBE0F0" } },
    { "name": "Parameter", "scope": ["variable.parameter", "meta.parameter variable", "entity.name.variable.parameter"], "settings": { "foreground": "#E2C9FF", "fontStyle": "italic" } },
    { "name": "Property", "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name", "entity.name.tag.yaml", "variable.other.member", "entity.other.attribute-name.class.css"], "settings": { "foreground": "#9CCFE8" } },
    { "name": "Builtin variable", "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super", "support.variable.self"], "settings": { "foreground": "#FF6FA8", "fontStyle": "italic" } },
    { "name": "Constant", "scope": ["variable.other.constant", "variable.other.enummember", "entity.name.constant", "support.constant", "variable.other.constant.property"], "settings": { "foreground": "#FFB86B" } },

    { "name": "Keyword", "scope": ["keyword", "keyword.control", "keyword.control.flow", "keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.other.package", "keyword.other.import", "keyword.function", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"], "settings": { "foreground": "#03E2C9" } },
    { "name": "Storage", "scope": ["storage", "storage.type", "storage.modifier", "keyword.other.var", "keyword.declaration", "storage.type.function.arrow"], "settings": { "foreground": "#3DADD7" } },
    { "name": "Operator", "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value", "punctuation.separator", "punctuation.terminator", "punctuation.definition.parameters", "punctuation.definition.block", "meta.brace", "punctuation.section"], "settings": { "foreground": "#7F97B2" } },

    { "name": "Function", "scope": ["entity.name.function", "meta.function-call entity.name.function", "support.function", "meta.function.method", "entity.name.method", "variable.function", "meta.method-call entity.name.function"], "settings": { "foreground": "#7AB8FF" } },
    { "name": "Builtin function", "scope": ["support.function.builtin", "support.function.go", "support.function.console"], "settings": { "foreground": "#7AB8FF", "fontStyle": "italic" } },

    { "name": "Type", "scope": ["entity.name.type", "entity.name.class", "entity.name.type.class", "entity.name.type.interface", "entity.name.type.enum", "entity.other.inherited-class", "support.type", "support.class", "storage.type.java", "storage.type.go", "storage.type.primitive", "storage.type.numeric.go", "storage.type.string.go", "storage.type.boolean.go", "entity.name.type.module"], "settings": { "foreground": "#F6C945" } },
    { "name": "Type parameter", "scope": ["entity.name.type.parameter", "storage.type.generic.java", "meta.type.parameters entity.name.type"], "settings": { "foreground": "#F6C945", "fontStyle": "italic" } },
    { "name": "Namespace / package", "scope": ["entity.name.namespace", "entity.name.type.namespace", "entity.name.package", "storage.modifier.package", "storage.modifier.import", "entity.name.import.go", "support.module"], "settings": { "foreground": "#8BA7FF" } },
    { "name": "Decorator / annotation", "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation", "punctuation.definition.annotation", "meta.annotation", "entity.name.type.annotation"], "settings": { "foreground": "#E879F9" } },

    { "name": "String", "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#5FD7A7" } },
    { "name": "Template expression", "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#03E2C9" } },
    { "name": "Escape", "scope": ["constant.character.escape", "constant.other.placeholder", "constant.character.format.placeholder"], "settings": { "foreground": "#FF4A90" } },
    { "name": "Regex", "scope": ["string.regexp", "constant.other.character-class.regexp"], "settings": { "foreground": "#FF9A3C" } },
    { "name": "Number / boolean / null", "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "constant.language.null", "constant.language.undefined", "constant.language.nil", "keyword.other.unit"], "settings": { "foreground": "#FF9A3C" } },

    { "name": "Tag", "scope": ["entity.name.tag", "support.class.component", "punctuation.definition.tag"], "settings": { "foreground": "#FF4A90" } },
    { "name": "Tag punctuation", "scope": ["punctuation.definition.tag.begin", "punctuation.definition.tag.end"], "settings": { "foreground": "#7F97B2" } },
    { "name": "Attribute", "scope": ["entity.other.attribute-name", "entity.other.attribute-name.jsx", "entity.other.attribute-name.html"], "settings": { "foreground": "#FFD580", "fontStyle": "italic" } },
    { "name": "CSS selector", "scope": ["entity.other.attribute-name.class", "entity.other.attribute-name.id", "entity.name.tag.css", "entity.other.attribute-name.pseudo-class"], "settings": { "foreground": "#F6C945" } },
    { "name": "CSS property value", "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color"], "settings": { "foreground": "#FFB86B" } },

    { "name": "JSON key", "scope": ["support.type.property-name.json", "support.type.property-name.json punctuation"], "settings": { "foreground": "#9CCFE8" } },
    { "name": "TOML / INI key", "scope": ["support.type.property-name.toml", "keyword.other.definition.ini", "entity.name.section"], "settings": { "foreground": "#9CCFE8" } },
    { "name": "Shell variable", "scope": ["variable.other.normal.shell", "variable.other.special.shell", "punctuation.definition.variable.shell"], "settings": { "foreground": "#9CCFE8" } },

    { "name": "Markdown heading", "scope": ["markup.heading", "markup.heading entity.name", "punctuation.definition.heading.markdown"], "settings": { "foreground": "#03E2C9", "fontStyle": "bold" } },
    { "name": "Markdown bold", "scope": ["markup.bold"], "settings": { "foreground": "#E6EDF3", "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "name": "Markdown code", "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"], "settings": { "foreground": "#5FD7A7" } },
    { "name": "Markdown link", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#3DADD7" } },
    { "name": "Markdown quote", "scope": ["markup.quote"], "settings": { "foreground": "#5A6B82", "fontStyle": "italic" } },
    { "name": "Markdown list", "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"], "settings": { "foreground": "#03E2C9" } },

    { "name": "Diff inserted", "scope": ["markup.inserted", "meta.diff.header.to-file"], "settings": { "foreground": "#5FD7A7" } },
    { "name": "Diff deleted", "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "#FF4A4A" } },
    { "name": "Diff changed", "scope": ["markup.changed"], "settings": { "foreground": "#F6C945" } },
    { "name": "Diff range", "scope": ["meta.diff.range", "meta.diff.header"], "settings": { "foreground": "#3DADD7" } },

    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF4A4A" } },
    { "name": "Deprecated", "scope": ["invalid.deprecated"], "settings": { "foreground": "#64748B", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "namespace": "#8BA7FF",
    "type": "#F6C945",
    "class": "#F6C945",
    "interface": "#F6C945",
    "enum": "#F6C945",
    "struct": "#F6C945",
    "typeParameter": { "foreground": "#F6C945", "italic": true },
    "parameter": { "foreground": "#E2C9FF", "italic": true },
    "variable": "#CBE0F0",
    "variable.readonly": "#CBE0F0",
    "variable.readonly.defaultLibrary": "#FFB86B",
    "variable.defaultLibrary": { "foreground": "#FF6FA8", "italic": true },
    "property": "#9CCFE8",
    "property.readonly": "#9CCFE8",
    "enumMember": "#FFB86B",
    "function": "#7AB8FF",
    "method": "#7AB8FF",
    "function.defaultLibrary": { "foreground": "#7AB8FF", "italic": true },
    "macro": "#E879F9",
    "decorator": "#E879F9",
    "annotation": "#E879F9",
    "keyword": "#03E2C9",
    "modifier": "#3DADD7",
    "string": "#5FD7A7",
    "number": "#FF9A3C",
    "regexp": "#FF9A3C",
    "operator": "#7F97B2",
    "comment": { "foreground": "#5A6B82", "italic": true },
    "*.deprecated": { "strikethrough": true }
  }
}
